# Velvet Crown Hotel Management System - Environment Configuration
# Copy this file to .env and adjust variables according to your local environment.

# ==============================================================================
# DATABASE CONFIGURATION (MySQL)
# ==============================================================================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hotel_management?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# ==============================================================================
# SPRING BOOT BACKEND PROFILES
# ==============================================================================
# 'mysql' for Live MySQL Database
# 'dev' for Self-contained persistent database with MySQL compatibility mode
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080/api
PORT=3000
